# litellm 機密 — cp secret.env.example secret.env 後填真值（secret.env gitignored）。
# DATABASE_URL 的密碼段須與 POSTGRES_PASSWORD 一致（litellm 只吃整條 URL，故兩處都要填）。
# 佔位值刻意含 @ 或短於八字元——避開機密掃描的字面樣式（例外規則見根 repo AGENTS.md〈各道掃描的例外不一樣〉）。
LITELLM_MASTER_KEY=sk-ch@nge
POSTGRES_PASSWORD=pg@pw
DATABASE_URL=postgresql://litellm:pg@pw@127.0.0.1:5432/litellm
# 實驗室的雲端來源：Groq 與 Cloudflare Workers AI 免費方案的金鑰
GROQ_API_KEY=gsk-ch@nge
CLOUDFLARE_API_KEY=cf-ch@nge
CLOUDFLARE_ACCOUNT_ID=ch@nge
