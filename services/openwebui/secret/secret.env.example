# openwebui 機密 — cp secret.env.example secret.env 後填真值（secret.env gitignored）。
# OPENAI_API_KEYS 填 litellm 發的 virtual key，key_alias 取 svc-openwebui；embedding 與 reranker 也用這把。
# DATABASE_URL 的密碼段須與 POSTGRES_PASSWORD 一致（openwebui 只吃整條 URL，故兩處都要填）。
# 佔位值刻意含 @——避開機密掃描的字面樣式（例外規則見根 repo 的 .claude/rules/githooks.md〈各道掃描的例外不一樣〉）。
OPENAI_API_KEYS=sk-ch@nge
POSTGRES_PASSWORD=pg@pw
DATABASE_URL=postgresql://openwebui:pg@pw@127.0.0.1:5432/openwebui
