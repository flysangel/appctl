# postgres 連線密碼（quay DB_URI 與 postgres POSTGRES_PASSWORD 共用）
# 注意：此值會內嵌進 DB_URI（postgresql://quayuser:<DB_PASSWORD>@127.0.0.1:5432/quay），
#       請只用英數字，避免 @ : / ? #（URL 保留字元會讓 host 解析錯位）。
DB_PASSWORD=changeme-db
# redis 密碼（quay config 與 redis REDIS_PASSWORD 共用）
REDIS_PASSWORD=changeme-redis
# quay 應用機密（UUID；可用 uuidgen 產生）
SECRET_KEY=changeme-secret-key-uuid
DATABASE_SECRET_KEY=changeme-db-secret-key-uuid
