# quay 應用設定範本（檔案型機密）。本檔是範本，真值檔為同目錄的 config.yaml（不入庫，
# 由 .gitignore 排除；缺席時 bin/svc.sh 會自本檔複製佔位值頂替）。
# config.yaml 由同目錄 kustomization.yaml 的 secretGenerator（files: [config.yaml]）讀取
# 產生 Secret quay-conf，以 volume 掛進 quay-app 容器。
# ${SERVER_HOSTNAME} 已改為字面值 quay.local；其餘四個佔位符（DB_PASSWORD、
# REDIS_PASSWORD、SECRET_KEY、DATABASE_SECRET_KEY）待人工填入真值。
# 注意：DB_PASSWORD 與 REDIS_PASSWORD 同時出現在同目錄 secret.env 與本檔，
# 兩處必須填相同的值；不一致時 quay 起得來但連不上 DB，渲染階段零徵兆。
# 本檔只留 quay 實際用到的鍵，其餘交給上游預設。要重產完整設定檔，把 quay-app 的 args 改成
# config <密碼> 起設定網頁，產出的 config.yaml 再放回本目錄。
AUTHENTICATION_TYPE: Database
AVATAR_KIND: local
BROWSER_API_CALLS_XHR_ONLY: false
BUILDLOGS_REDIS:
    host: 127.0.0.1
    password: "${REDIS_PASSWORD}"
    port: 6379
DATABASE_SECRET_KEY: "${DATABASE_SECRET_KEY}"
DB_CONNECTION_ARGS: {}
DB_URI: postgresql://quayuser:${DB_PASSWORD}@127.0.0.1:5432/quay
# 刪掉的 tag 與映像層保留兩週才被 GC 回收，刪 tag 後磁碟不會馬上變小；TAG_EXPIRATION_OPTIONS 是使用者可選的清單。
DEFAULT_TAG_EXPIRATION: 2w
DISTRIBUTED_STORAGE_CONFIG:
    default:
        - LocalStorage
        - storage_path: /datastorage/registry
DISTRIBUTED_STORAGE_DEFAULT_LOCATIONS: []
DISTRIBUTED_STORAGE_PREFERENCE:
    - default
FEATURE_ANONYMOUS_ACCESS: true
FEATURE_DIRECT_LOGIN: true
FEATURE_EXTENDED_REPOSITORY_NAMES: true
FEATURE_SECURITY_SCANNER: false
FEATURE_USER_CREATION: false
FEATURE_USER_INITIALIZE: true
LOGS_MODEL: database
# 前面加 TLS 終結時要改 https，否則導向與 token realm 仍是 http。
PREFERRED_URL_SCHEME: http
REGISTRY_TITLE: Project Quay
REGISTRY_TITLE_SHORT: Project Quay
SECRET_KEY: "${SECRET_KEY}"
SERVER_HOSTNAME: "quay.local"
# 拿掉 SETUP_COMPLETE，quay 會進設定模式不提供服務。
SETUP_COMPLETE: true
# /api/v1/user/initialize 建的第一個帳號名要等於這裡列的名字，否則它不是 superuser；Quay 文件：該 API 只在使用者表為空時開放。
SUPER_USERS:
    - quay
TAG_EXPIRATION_OPTIONS:
    - 1d
    - 1w
    - 2w
    - 4w
TESTING: false
USER_EVENTS_REDIS:
    host: 127.0.0.1
    password: "${REDIS_PASSWORD}"
    port: 6379
USERFILES_LOCATION: default
